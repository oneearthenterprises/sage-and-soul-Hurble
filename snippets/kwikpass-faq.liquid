          </div>
        </details>

        <details style="background: #ffffff; border: 1px solid #e5e7eb; border-radius: 10px; padding: 1rem 1.25rem; cursor: pointer; transition: all 0.2s ease;">
          <summary style="font-weight: 500; font-size: 0.95rem; color: #111827; list-style: none; display: flex; justify-content: space-between; align-items: center;">
            <span>How do I brew Sage & Soul herbal infusions?</span>
            <span style="font-size: 1.2rem; color: #9ca3af; font-weight: 300;">+</span>
          </summary>
          <div style="margin-top: 0.75rem; font-size: 0.875rem; line-height: 1.6; color: #4b5563; border-top: 1px solid #f3f4f6; padding-top: 0.75rem;">
            Place 1 pyramid tea bag in your cup, pour 150ml–200ml of freshly boiled water, and steep for <strong>3 to 5 minutes</strong>. You can enjoy it hot or chilled.
          </div>
        </details>

        <details style="background: #ffffff; border: 1px solid #e5e7eb; border-radius: 10px; padding: 1rem 1.25rem; cursor: pointer; transition: all 0.2s ease;">
          <summary style="font-weight: 500; font-size: 0.95rem; color: #111827; list-style: none; display: flex; justify-content: space-between; align-items: center;">
            <span>What is your return & replacement policy?</span>
            <span style="font-size: 1.2rem; color: #9ca3af; font-weight: 300;">+</span>
          </summary>
          <div style="margin-top: 0.75rem; font-size: 0.875rem; line-height: 1.6; color: #4b5563; border-top: 1px solid #f3f4f6; padding-top: 0.75rem;">
            If you receive a damaged, leaked, or wrong product, please contact us at <strong>support@mysagensoul.com</strong> within 48 hours with photos, and we will issue an immediate replacement or refund.
          </div>
        </details>
      </div>
    </div>
  `;

  // Standard GoKwik custom nav event dispatcher (ONLY events, NO DOM tampering)
  function sendFaqContent() {
    window.dispatchEvent(
      new CustomEvent('kp-account:custom-nav', {
        detail: {
          id: 'faqs',
          content: defaultFaqHtml
        }
      })
    );

    // Also dispatch for 'faq' in case the KwikPass ID is singular
    window.dispatchEvent(
      new CustomEvent('kp-account:custom-nav', {
        detail: {
          id: 'faq',
          icon: "https://cdn.shopify.com/s/files/1/0674/9972/0775/files/FAQ.svg?v=1792136661",
          iconUrl: "https://cdn.shopify.com/s/files/1/0674/9972/0775/files/FAQ.svg?v=1792136661",
          content: defaultFaqHtml
        }
      })
    );
  }

  const FAQ_SVG_HTML = `<svg class="w-6 h-6 kp-faq-custom-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 90 75" width="22" height="22" style="width: 22px; height: 22px; min-width: 22px; max-width: 22px; max-height: 22px; display: inline-block; vertical-align: middle;">
