<!-- GoKwik KwikPass FAQs Section Integration -->
<script>
(function() {
  const defaultFaqHtml = `
    <div class="kp-custom-faq-container" style="font-family: inherit; padding: 1.5rem 1rem; max-width: 850px; margin: 0 auto; color: #1f2937;">
      <div style="margin-bottom: 1.5rem;">
        <h3 style="font-size: 1.35rem; font-weight: 600; color: #111827; margin: 0 0 0.35rem 0;">Frequently Asked Questions</h3>
        <p style="font-size: 0.875rem; color: #6b7280; margin: 0;">Find answers to common questions about your orders, delivery, and Sage & Soul rituals.</p>
      </div>

      <div style="display: flex; flex-direction: column; gap: 0.85rem;">
        <details style="background: #ffffff; border: 1px solid #e5e7eb; border-radius: 10px; padding: 1rem 1.25rem; cursor: pointer; transition: all 0.2s ease;">
          <summary style="font-weight: 500; font-size: 0.95rem; color: #111827; list-style: none; display: flex; justify-content: space-between; align-items: center;">
            <span>How do I track my order?</span>
            <span style="font-size: 1.2rem; color: #9ca3af; font-weight: 300;">+</span>
          </summary>
          <div style="margin-top: 0.75rem; font-size: 0.875rem; line-height: 1.6; color: #4b5563; border-top: 1px solid #f3f4f6; padding-top: 0.75rem;">
            You can track your order directly from the <strong>My Orders</strong> tab in your account. Additionally, tracking details and a live tracking link are sent to your registered email and mobile number via SMS/WhatsApp once your order is dispatched.
          </div>
        </details>

        <details style="background: #ffffff; border: 1px solid #e5e7eb; border-radius: 10px; padding: 1rem 1.25rem; cursor: pointer; transition: all 0.2s ease;">
          <summary style="font-weight: 500; font-size: 0.95rem; color: #111827; list-style: none; display: flex; justify-content: space-between; align-items: center;">
            <span>How long does delivery take?</span>
            <span style="font-size: 1.2rem; color: #9ca3af; font-weight: 300;">+</span>
          </summary>
          <div style="margin-top: 0.75rem; font-size: 0.875rem; line-height: 1.6; color: #4b5563; border-top: 1px solid #f3f4f6; padding-top: 0.75rem;">
            Orders are dispatched within 24–48 business hours. Depending on your delivery pincode, delivery usually takes <strong>3 to 5 business days</strong> across India.
          </div>
        </details>

        <details style="background: #ffffff; border: 1px solid #e5e7eb; border-radius: 10px; padding: 1rem 1.25rem; cursor: pointer; transition: all 0.2s ease;">
          <summary style="font-weight: 500; font-size: 0.95rem; color: #111827; list-style: none; display: flex; justify-content: space-between; align-items: center;">
            <span>What are the ingredients in Sage & Soul infusions?</span>
            <span style="font-size: 1.2rem; color: #9ca3af; font-weight: 300;">+</span>
          </summary>
          <div style="margin-top: 0.75rem; font-size: 0.875rem; line-height: 1.6; color: #4b5563; border-top: 1px solid #f3f4f6; padding-top: 0.75rem;">
            Every Sage & Soul blend is crafted with 100% natural, ethically sourced botanicals, whole flower petals, and ayurvedic herbs with no artificial flavours, preservatives, or refined sugars.
          </div>
        </details>

        <details style="background: #ffffff; border: 1px solid #e5e7eb; border-radius: 10px; padding: 1rem 1.25rem; cursor: pointer; transition: all 0.2s ease;">
          <summary style="font-weight: 500; font-size: 0.95rem; color: #111827; list-style: none; display: flex; justify-content: space-between; align-items: center;">
            <span>How do I brew Sage & Soul herbal infusions?</span>
            <span style="font-size: 1.2rem; color: #9ca3af; font-weight: 300;">+</span>
          </summary>
          <div style="margin-top: 0.75rem; font-size: 0.875rem; line-height: 1.6; color: #4b5563; border-top: 1px solid #f3f4f6; padding-top: 0.75rem;">
            Place 1 pyramid tea bag in your cup, pour 150ml–200ml of freshly boiled water, and steep for <strong>3 to 5 minutes</strong>. You can enjoy it hot or chilled.
          </div>
        </details>

        <details style="background: #ffffff; border: 1px solid #e5e7eb; border-radius: 10px; padding: 1rem 1.25rem; cursor: pointer; transition: all 0.2s ease;">
          <summary style="font-weight: 500; font-size: 0.95rem; color: #111827; list-style: none; display: flex; justify-content: space-between; align-items: center;">
            <span>What is your return & replacement policy?</span>
            <span style="font-size: 1.2rem; color: #9ca3af; font-weight: 300;">+</span>
          </summary>
          <div style="margin-top: 0.75rem; font-size: 0.875rem; line-height: 1.6; color: #4b5563; border-top: 1px solid #f3f4f6; padding-top: 0.75rem;">
            If you receive a damaged, leaked, or wrong product, please contact us at <strong>support@mysagensoul.com</strong> within 48 hours with photos, and we will issue an immediate replacement or refund.
          </div>
        </details>
      </div>
    </div>
  `;

  // Standard GoKwik custom nav event dispatcher (ONLY events, NO DOM tampering)
  function sendFaqContent() {
    window.dispatchEvent(
      new CustomEvent('kp-account:custom-nav', {
        detail: {
          id: 'faqs',
          content: defaultFaqHtml
        }
      })
    );

    // Also dispatch for 'faq' in case the KwikPass ID is singular
    window.dispatchEvent(
      new CustomEvent('kp-account:custom-nav', {
        detail: {
          id: 'faq',
          content: defaultFaqHtml
        }
      })
    );
  }

  function bindExistingFaqTab() {
    const host = document.querySelector('main') || document.querySelector('kp-account') || document.querySelector('#kp-container');
    if (!host || !host.shadowRoot) return;

    const shadow = host.shadowRoot;
    const sidebar = shadow.querySelector('#kp-sidebar-wrapper') || shadow;

    // Attach click to the existing FAQs tab inside the sidebar
    const sidebarButtons = sidebar.querySelectorAll('button, a, div[role="button"]');
    sidebarButtons.forEach(function(btn) {
      const txt = (btn.textContent || '').trim().toLowerCase();
      const navPath = btn.getAttribute('data-nav-path') || '';

      if (txt.includes('faq') || navPath.includes('faq')) {
        if (!btn.dataset.faqEventBound) {
          btn.dataset.faqEventBound = "true";
          btn.addEventListener('click', function() {
            sendFaqContent();
          });
        }
      }
    });

    // If currently on FAQs view on initial load, dispatch content
    if (window.location.href.includes('faq')) {
      sendFaqContent();
    }
  }

  // Lifecycle listeners
  window.addEventListener('SIDEBAR_LOADED', function() {
    bindExistingFaqTab();
    sendFaqContent();
  });

  window.addEventListener('DOMContentLoaded', bindExistingFaqTab);
  window.addEventListener('load', bindExistingFaqTab);

  // Poll for Shadow DOM readiness
  let attempts = 0;
  const pollTimer = setInterval(function() {
    attempts++;
    bindExistingFaqTab();
    if (window.location.href.includes('faq')) {
      sendFaqContent();
    }
    if (attempts >= 10) {
      clearInterval(pollTimer);
    }
  }, 400);

  // Re-trigger if URL route changes
  window.addEventListener('popstate', sendFaqContent);
  window.addEventListener('hashchange', sendFaqContent);
})();
</script>
