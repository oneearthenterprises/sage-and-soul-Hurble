<path d="M0 0 C5.69 5.11 9.62 10.56 10.28 18.27 C10.52 27.53 9.69 33.88 3.94 41.19 C-2.32 47.78 -8.48 50.28 -17.56 50.56 C-25.93 50.24 -31.6 48.44 -37.81 42.81 C-43.99 36.06 -46.31 28.08 -46 19 C-44.79 11.1 -41.32 4.58 -35.15 -0.54 C-24.06 -8.11 -10.98 -7.46 0 0 Z M-36 9 C-40.18 15 -41.01 20.8 -40 28 C-38.13 34.7 -33.58 39.07 -28 43 C-23.21 45.34 -18.24 45.81 -13 45 C-4.8 42.16 -0.32 38.25 3.81 30.69 C5.94 24.1 5.83 19.16 2.94 12.81 C-0.2 7.11 -3.98 3.48 -9.81 0.62 C-20.46 -1.46 -28.92 0.34 -36 9 Z" fill="#1C2A3E" transform="translate(79,24)"/>
