<path d="M0 0 C5.61 0 11.22 0 17 0 C16 5 16 5 15 6 C12.69 6.13 10.38 6.18 8.06 6.19 C6.8 6.2 5.53 6.22 4.22 6.23 C1 6 1 6 -1 4 C-0.67 2.68 -0.34 1.36 0 0 Z" fill="#1C2A3E" transform="translate(15,32)"/>
</svg>`;

  function updateFaqIconInSidebar(shadow) {
    if (!shadow) return;
    const sidebar = shadow.querySelector('#kp-sidebar-wrapper') || shadow;
    const sidebarButtons = sidebar.querySelectorAll('button, a, div[role="button"]');
    sidebarButtons.forEach(function(btn) {
      const txt = (btn.textContent || '').trim().toLowerCase();
      const navPath = (btn.getAttribute('data-nav-path') || '').toLowerCase();

      if (txt.includes('faq') || navPath.includes('faq')) {
        const iconWrapper = btn.querySelector('.flex-shrink-0') || btn.querySelector('div:first-child');
        if (iconWrapper && iconWrapper !== btn) {
          if (!iconWrapper.querySelector('.kp-faq-custom-icon')) {
            iconWrapper.innerHTML = KP_FAQ_SVG_HTML;
          }
        } else {
          const allIcons = btn.querySelectorAll('svg, img');
          for (let i = 0; i < allIcons.length; i++) {
            const el = allIcons[i];
            const src = (el.getAttribute('src') || '').toLowerCase();
            const alt = (el.getAttribute('alt') || '').toLowerCase();
            if (src.includes('chevron') || alt.includes('chevron')) continue;
            if (!el.classList.contains('kp-faq-custom-icon')) {
              el.outerHTML = KP_FAQ_SVG_HTML;
              break;
            }
          }
        }
      }
    });
  }

  function styleOnlyRecommendationButton(shadow) {
    // 1. First, strictly ensure the sidebar profile card is reset to WHITE
    const sidebar = shadow.querySelector('#kp-sidebar-wrapper');
    if (sidebar) {
      const sidebarCards = sidebar.querySelectorAll('div, button');
      sidebarCards.forEach(function(el) {
        // Remove any wrong green background on sidebar items
        if (el.style.backgroundColor === 'rgb(27, 67, 50)' || el.style.backgroundColor === '#1b4332') {
          el.style.removeProperty('background-color');
          el.style.removeProperty('color');
        }
      });
    }

    // 2. Find ONLY the "View More Details" button in the right content panel
    const allButtons = shadow.querySelectorAll('button, a, div[role="button"]');
    allButtons.forEach(function(btn) {
      // NEVER touch anything in the sidebar
      if (btn.closest('#kp-sidebar-wrapper')) return;

      const txt = (btn.textContent || '').trim().toLowerCase();
      // Match EXACT phrase "view more details"
      if (txt === 'view more details' || txt === 'view details') {
        btn.classList.add('kp-view-more-details-btn');
        btn.style.setProperty('background-color', '#1b4332', 'important');
        btn.style.setProperty('color', '#ffffff', 'important');
        btn.style.setProperty('font-weight', '600', 'important');
        btn.style.setProperty('border-radius', '8px', 'important');
        btn.style.setProperty('border', 'none', 'important');
        btn.style.setProperty('padding', '10px 18px', 'important');

        // Make all child spans/text pure white
        btn.querySelectorAll('*').forEach(function(child) {
          child.style.setProperty('color', '#ffffff', 'important');
        });
      }
    });
  }

  // Lifecycle listeners
  window.addEventListener('SIDEBAR_LOADED', applyKwikPassDesign);
  window.addEventListener('DOMContentLoaded', applyKwikPassDesign);
  window.addEventListener('load', applyKwikPassDesign);
  setInterval(applyKwikPassDesign, 400);
})();
</script>
