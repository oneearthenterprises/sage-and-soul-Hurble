<section class="ingredient-trust-section page-width section">
  <div class="its-container">

    <!-- Header -->
    <div class="its-header">
      <h3 class="its-heading">{{ section.settings.heading }}</h3>
      <p class="its-subtext">{{ section.settings.subtext }}</p>
    </div>

    <!-- Feature Cards -->
    <div class="its-cards">

      <div class="its-card">
     <div class="its-card-icon">
  {% if section.settings.card1_icon != blank %}
    {{
      section.settings.card1_icon
      | image_url: width: 120
      | image_tag:
        loading: 'lazy',
        widths: '60, 90, 120',
        class: 'its-icon-image',
        alt: section.settings.card1_title
    }}
  {% endif %}
</div>
        <div class="its-card-body">
          <h4 class="its-card-title">{{ section.settings.card1_title }}</h4>
          <p class="its-card-text">{{ section.settings.card1_text }}</p>
        </div>
      </div>

      <div class="its-card">
     <div class="its-card-icon">
  {% if section.settings.card2_icon != blank %}
    {{
      section.settings.card2_icon
      | image_url: width: 120
      | image_tag:
        loading: 'lazy',
        widths: '60, 90, 120',
        class: 'its-icon-image',
        alt: section.settings.card2_title
    }}
  {% endif %}
</div>
        <div class="its-card-body">
          <h4 class="its-card-title">{{ section.settings.card2_title }}</h4>
          <p class="its-card-text">{{ section.settings.card2_text }}</p>
        </div>
      </div>

    </div>

    <!-- CTA -->
    <div class="its-cta-wrap">
      <a href="{{ section.settings.button_link }}" class="its-cta-btn">
        {{ section.settings.button_text }}
        {% comment %} <span class="its-arrow">→</span> {% endcomment %}
      </a>
    </div>

  </div>
</section>

<style>


  .its-icon-image {
  width: 36px;
  height: 36px;
  object-fit: contain;
  display: block;
}

@media (max-width: 768px) {
  .its-icon-image {
    width: 30px;
    height: 30px;
  }
}
.ingredient-trust-section {
  padding-block: 60px;
}

.its-container {
  background-color: {{ section.settings.background_color }};
  border-radius: 16px;
  border: 1px solid #dde8e3;
  padding: clamp(32px, 5vw, 64px) clamp(24px, 5vw, 60px);
  position: relative;
  overflow: hidden;
}



/* Header */
.its-header {
  max-width: 720px;
  margin: 0 auto 48px;
  text-align: center;
  position: relative;
}

.its-heading {
  font-size: clamp(22px, 3vw, 30px);
  font-weight: 700;
  color: #000000;
  line-height: 1.3;
  margin: 0 0 16px;
  letter-spacing: -0.01em;
}

.its-subtext {
  font-size: clamp(14px, 1.6vw, 16px);
  color: #000000;
  line-height: 1.75;
  margin: 0;
}

/* Cards grid */
.its-cards {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24px;
  margin-bottom: 40px;
  position: relative;
}

.its-card {
  background: #ffffff;
  border-radius: 12px;
  border: 1px solid #d9e8e0;
  padding: 32px 28px;
  display: flex;
  align-items: flex-start;
  gap: 20px;
  transition: transform 0.3s ease, box-shadow 0.3s ease;
  position: relative;
  overflow: hidden;
}

.its-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 3px;
  background: linear-gradient(90deg, #1e4d3a, #b89e6a);
  opacity: 0;
  transition: opacity 0.3s ease;
}

.its-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 12px 32px rgba(30, 77, 58, 0.1);
}

.its-card:hover::before {
  opacity: 1;
}

.its-card-icon {
  flex-shrink: 0;
  width: 56px;
  height: 56px;
  background: #eef5f0;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 10px;
  transition: background 0.3s ease;
}

.its-card:hover .its-card-icon {
  background: #d5e8dd;
}

.its-card-icon svg {
  width: 36px;
  height: 36px;
}

.its-card-body {
  flex: 1;
}

.its-card-title {
  font-size: clamp(15px, 1.6vw, 17px);
  font-weight: 700;
  color: #1e4d3a;
  margin: 0 0 10px;
  line-height: 1.3;
}

.its-card-text {
  font-size: clamp(13px, 1.4vw, 14px);
  color: #5a6a5e;
  line-height: 1.65;
  margin: 0;
}

/* CTA */
.its-cta-wrap {
  text-align: center;
  position: relative;
}

.its-cta-btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 14px 36px;
  background: #1e4d3a;
  color: #fff;
  font-size: 15px;
  font-weight: 600;
  text-decoration: none;
  border-radius: 6px;
  border: 2px solid #1e4d3a;
  transition: all 0.3s ease;
  letter-spacing: 0.02em;
}

.its-cta-btn:hover {
  background: transparent;
  color: #1e4d3a;
}

.its-arrow {
  display: inline-block;
  transition: transform 0.3s ease;
}

.its-cta-btn:hover .its-arrow {
  transform: translateX(4px);
}

/* Mobile */
@media (max-width: 768px) {
  .ingredient-trust-section {
    padding-block: 32px;
  }

  .its-container {
    padding: 28px 20px;
  }

  .its-header {
    margin-bottom: 28px;
  }

  .its-cards {
    grid-template-columns: 1fr;
    gap: 16px;
    margin-bottom: 28px;
  }

  .its-card {
    padding: 24px 20px;
    gap: 16px;
  }

  .its-card-icon {
    width: 48px;
    height: 48px;
  }

  .its-cta-btn {
    width: 100%;
    justify-content: center;
  }
}
</style>

{% schema %}
{
  "name": "Ingredient Trust Section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Every Infusion Starts With a Real Ingredient List"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "We're not big on mystery blends. Every pouch we make lists exactly what's inside — no vague \"herbal complex\" language standing in for actual botanicals. It's a small thing, but it's the one rule we haven't broken since day one."
    },
    {
      "type": "text",
      "id": "card1_title",
      "label": "Card 1 Title",
      "default": "Premium, Traceable Botanicals"
    },
    {
      "type": "textarea",
      "id": "card1_text",
      "label": "Card 1 Text",
      "default": "Flowers, roots, and herbs sourced with a clear origin — not filler dust dressed up in a nice pouch."
    },
    {
  "type": "image_picker",
  "id": "card1_icon",
  "label": "Card 1 Icon"
},
    {
      "type": "text",
      "id": "card2_title",
      "label": "Card 2 Title",
      "default": "Built Around Daily Habits"
    },
    {
      "type": "textarea",
      "id": "card2_text",
      "label": "Card 2 Text",
      "default": "Made for the cup you'll actually finish, not the one that sits half-drunk on your desk by 4 PM."
    },
    {
  "type": "image_picker",
  "id": "card2_icon",
  "label": "Card 2 Icon"
},
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Shop the Full Collection"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
  "type": "color",
  "id": "background_color",
  "label": "Container Background Color",
  "default": "#F9F6F1"
},
  ],
  "presets": [
    {
      "name": "Ingredient Trust Section"
    }
  ]
}
{% endschema %}
