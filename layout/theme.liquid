{% comment %} Deferred loading of heavy third-party marketing & tracking scripts to maximize PageSpeed score (LCP/TBT) {% endcomment %}
<script type="text/javascript">
(function() {
  var scriptsLoaded = false;
  
  function loadTrackingScripts() {
    if (scriptsLoaded) return;
    scriptsLoaded = true;
    
    // Remove listeners
    window.removeEventListener('scroll', loadTrackingScripts);
    window.removeEventListener('mousemove', loadTrackingScripts);
    window.removeEventListener('touchstart', loadTrackingScripts);
    window.removeEventListener('keydown', loadTrackingScripts);
    




    // 3. Google tag (gtag.js)
    var gtagScript = document.createElement('script');
    gtagScript.src = "https://www.googletagmanager.com/gtag/js?id=AW-17948940606";
    document.head.appendChild(gtagScript);

    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    window.gtag = gtag;
    gtag('js', new Date());
    gtag('config', 'AW-17948940606');
  }

  // Bind interaction event listeners
  window.addEventListener('scroll', loadTrackingScripts, { passive: true });
  window.addEventListener('mousemove', loadTrackingScripts, { passive: true });
  window.addEventListener('touchstart', loadTrackingScripts, { passive: true });
  window.addEventListener('keydown', loadTrackingScripts, { passive: true });

  // Safety fallback: load after 5.5 seconds if no interaction happens
  setTimeout(loadTrackingScripts, 5500);
})();
</script>



 

